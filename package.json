{
  "name": "@sequencemedia/eslint-config-standard",
  "version": "0.3.4",
  "description": "Standard configuration for ESLint 9 and 10",
  "keywords": [
    "JavaScript Standard Style",
    "check",
    "checker",
    "code",
    "code checker",
    "code linter",
    "code standards",
    "code style",
    "enforce",
    "eslint",
    "eslintconfig",
    "hint",
    "jscs",
    "jshint",
    "lint",
    "policy",
    "quality",
    "simple",
    "standard",
    "standard style",
    "style",
    "style checker",
    "style linter",
    "verify"
  ],
  "main": "./index.mjs",
  "type": "module",
  "author": {
    "name": "Jonathan Perry for Sequence Media Limited",
    "email": "sequencemedia@sequencemedia.net",
    "url": "https://sequencemedia.net"
  },
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sequencemedia/eslint-config-standard.git"
  },
  "homepage": "https://github.com/sequencemedia/eslint-config-standard#readme",
  "bugs": {
    "url": "https://github.com/sequencemedia/eslint-config-standard/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "node husky.mjs",
    "test": "mocha test --recursive --verbose --color"
  },
  "dependencies": {
    "@sequencemedia/eslint-merge": "^0.0.97",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.72.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "chai": "^6.3.0",
    "eslint": "10.14.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.38.0 || ^10.0.0"
  },
  "imports": {
    "#eslint-config-standard": "./index.mjs",
    "#eslint-config-standard/configs": "./configs/index.mjs",
    "#eslint-config-standard/configs/*": "./configs/*.mjs",
    "#eslint-config-standard/merge": "./merge.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./configs": "./configs/index.mjs",
    "./configs/*": "./configs/*.mjs",
    "./merge": "./merge.mjs"
  }
}
